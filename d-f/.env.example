# PostgreSQL connection for the civic frontend database.
# Replace the example credentials locally; never commit a real connection string.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/app_db

# The browser-facing frontend API proxy connects to this backend origin.
GOVLINKS_API_URL=http://127.0.0.1:8080

# Optional OpenAI-compatible chat completion provider for the Sewak assistant.
# Leave unset to use local case matching without sending queries to an LLM.
# Keep provider keys server-side; never prefix them with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional HTTPS base URL for a compatible provider; defaults to OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1
